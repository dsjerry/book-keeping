# 配置模板——复制为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 已被 git 忽略，切勿提交真实密钥

# 应用信息
APP_NAME=记账本
AUTHOR=your-name
AUTHOR_AKA=your-aka
EMAIL=your-email@example.com
SITE=https://example.com

# DeepSeek API（AI 分析）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 高德地图 Web 服务 key（用于逆地理编码获取附近地址，32 位十六进制）
# 申请地址: https://console.amap.com/dev/key/app
AMAP_API_KEY=your-amap-web-service-key

# 高德地图 Android 平台 key（用于地图选点底图渲染，需绑定包名 com.dsjerry.bk + 签名 SHA1）
# 申请地址: https://console.amap.com/dev/key/app 选择 "Android 平台"
AMAP_ANDROID_KEY=your-amap-android-key

# 高德 Web 端 JSAPI key + 安全密钥（用于 WebView 地图选点，v2.0 必须）
# 申请地址: https://console.amap.com/dev/key/app 选择 "Web端(JS API)"
AMAP_JSAPI_KEY=your-amap-jsapi-key
AMAP_JSAPI_SECURITY_CODE=your-amap-jsapi-security-code

# 坐标系统：gcj02（默认，GPS WGS84 转 GCJ02 后请求高德）/ wgs84（原样请求，会有偏差）
COORD_SYSTEM=gcj02

# 后端 API 地址
API_URL=https://your-server.example.com

# 应用版本号
APP_VERSION=1.0.2
